@page "/schools"
@rendermode InteractiveServer
@using SchoolDirectory.Models
@using SchoolDirectory.Services
@inject SchoolService SchoolService

<PageTitle>School Directory</PageTitle>

<h1>School Directory</h1>

<p>Browse schools and select one to view its details.</p>

<label for="school-search">Search schools by name</label>
<input id="school-search"
       type="text"
       @bind="searchTerm"
       @bind:event="oninput"
       placeholder="Enter a school name..." />

@if (isLoading)
{
    <p>Loading schools...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p role="alert">@errorMessage</p>
}
else if (filteredSchools.Count == 0)
{
    <p>No schools match your search.</p>
}
else
{
    <p>Schools found: @filteredSchools.Count</p>

    <div class="school-list">
        @foreach (var school in filteredSchools)
        {
            <SchoolCard School="school"
                        OnSelect="HandleSchoolSelected" />
        }
    </div>
}

@code {
    private List<School> schools = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string searchTerm = string.Empty;

    // Store the school selected by a child component.
    private School? selectedSchool;

    // Filter schools by name without distinguishing uppercase and lowercase.
    private List<School> filteredSchools =>
        schools
            .Where(school => school.SchoolName.Contains(
                searchTerm,
                StringComparison.OrdinalIgnoreCase))
            .ToList();

    // Load the school list when the page is initialized.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            schools = await SchoolService.GetSchoolsAsync();
        }
        catch (Exception)
        {
            errorMessage = "Unable to load schools. Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Receive the selected school from SchoolCard.
    private void HandleSchoolSelected(School school)
    {
        selectedSchool = school;
    }
}